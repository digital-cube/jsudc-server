{
  "name": "@jsudc/server",
  "version": "0.9.0",
  "private": false,
  "type": "module",
  "description": "A UDC server in TypeScript: the dispatcher, the collection registry, sources (memory, filesystem, HTTP API, YAML menu, a SQLite table; Postgres jsonb and table from @jsudc/server/postgres, node:sqlite from @jsudc/server/sqlite, better-sqlite3 from @jsudc/server/better-sqlite3), schema revisions and edits, seeding, and a Fastify plugin.",
  "keywords": [
    "udc",
    "jsudc",
    "universal-data-collection",
    "universal-data-collections",
    "data-grid",
    "fastify",
    "fastify-plugin",
    "postgres",
    "jsonb",
    "sqlite",
    "drizzle",
    "better-sqlite3"
  ],
  "license": "MIT",
  "author": "DigitalCube",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digital-cube/jsudc-server.git"
  },
  "homepage": "https://github.com/digital-cube/jsudc-server#readme",
  "bugs": {
    "url": "https://github.com/digital-cube/jsudc-server/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "default": "./dist/postgres.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "default": "./dist/sqlite.js"
    },
    "./better-sqlite3": {
      "types": "./dist/better-sqlite3.d.ts",
      "default": "./dist/better-sqlite3.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:sqlite": "vitest run --project sqlite-table",
    "test:no-db": "vitest run --project no-db --project sqlite-table",
    "test:no-pg": "node test/no-pg/run.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@jsudc/core": "^0.8.0",
    "better-sqlite3": ">=11.0.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "@fastify/swagger": {
      "optional": true
    },
    "@fastify/swagger-ui": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "fastify-type-provider-zod": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@jsudc/core": "^0.8.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.5",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
